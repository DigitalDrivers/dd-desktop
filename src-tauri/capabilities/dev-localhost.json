{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dev-localhost",
  "description": "Development only (enabled through tauri.dev.conf.json): a platform running on this machine",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://localhost:3000"]
  },
  "permissions": ["allow-system-check", "allow-show-toast", "allow-setup-status", "allow-install-setup", "allow-remove-setups", "allow-launch-ac-evo", "allow-update-check", "allow-update-install", "allow-update-at-start", "allow-car-status", "allow-install-car", "allow-live-snapshot", "allow-take-laps", "core:event:allow-listen", "core:event:allow-unlisten"]
}
