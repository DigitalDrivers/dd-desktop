{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digital Drivers",
  "version": "0.20.0",
  "identifier": "club.digitaldrivers.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "create": false,
        "title": "Digital Drivers",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "local",
        "platform"
      ]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Digital Drivers",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4ODEzMTY3Q0I4MkE4NDMKUldSRHFJTExaekdCZUVsMHpNb3hWVlJCN1pIdHNHVlVaQUgrVVEraDkycDhvUmhOVmY0KzNWQUgK",
      "endpoints": [
        "https://github.com/DigitalDrivers/dd-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
